# GateKeeper environment template
# Copy to .env.local for development or configure these variables in Vercel.
# Never commit real secrets.

# Runtime mode
# Required in production. Allowed: development, test, production.
NODE_ENV=development

# App URLs
# Required in production. Must be HTTPS and must not end with a slash.
# Use the same value for APP_URL and NEXT_PUBLIC_APP_URL in production.
APP_URL=https://your-domain.example
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Legacy aliases still read by older deployments, but prefer APP_URL/NEXT_PUBLIC_APP_URL.
APP_ORIGIN=
NEXT_PUBLIC_APP_ORIGIN=

# Database
# Required in production. Must be a PostgreSQL URL.
# Development may use a local database explicitly.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gatekeeper
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/gatekeeper
# Per app instance. Keep this small on serverless deployments to avoid exhausting Postgres.
DATABASE_POOL_MAX=5

# Supabase Auth
# Required in production.
# NEXT_PUBLIC_* values are safe for browser use. SUPABASE_SERVICE_ROLE_KEY is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Supabase dashboard redirects to configure manually:
# - Site URL: https://your-domain.example
# - Additional Redirect URLs:
#   https://your-domain.example/auth
#   https://your-domain.example/auth/reset-password
#   http://localhost:3000/auth
#   http://localhost:3000/auth/reset-password
#   http://localhost:3001/auth
#   http://localhost:3001/auth/reset-password

# PayPal
# Required in production when PayPal checkout is offered.
# PAYPAL_ENV must be "sandbox" or "live".
# Production must use "live" unless PAYPAL_ALLOW_SANDBOX_IN_PRODUCTION=true is set intentionally.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret
# Required in production. Create a webhook in PayPal Developer Dashboard that points to:
# https://your-domain.example/api/paypal/webhook
PAYPAL_WEBHOOK_ID=replace-with-paypal-webhook-id
PAYPAL_CURRENCY=EUR
PAYPAL_ALLOW_SANDBOX_IN_PRODUCTION=false

# Stripe
# Required in production when Stripe checkout is offered.
# Create a webhook in Stripe Dashboard that points to:
# https://your-domain.example/api/stripe/webhook
# Subscribe to checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# payment_intent.succeeded, payment_intent.processing, payment_intent.payment_failed,
# payment_intent.canceled, charge.refunded, and refund.updated.
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_CURRENCY=EUR

# Transactional mail for tickets, payment notices, reminders, cancellations, and event alerts.
# Auth signup and password-reset mails are sent by Supabase Auth and must be configured in Supabase.
# Configure either Resend or SMTP in production.
EMAIL_PROVIDER=auto
EMAIL_FROM=mail@your-domain.example
RESEND_API_KEY=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_SERVER_SECURE=false

# Ticket and scanner security
# Required in production. Use long independent random values.
TICKET_QR_SECRET=replace-with-long-random-ticket-secret
SCANNER_LINK_SECRET=replace-with-long-random-scanner-secret

# Manual payments
# Required in production because bank transfer is offered in checkout.
BANK_TRANSFER_ACCOUNT_HOLDER=GateKeeper
BANK_TRANSFER_IBAN=DE00 0000 0000 0000 0000 00
BANK_TRANSFER_BIC=ABCDEFGHXXX
PAYMENT_REMINDER_INTERVALS=3,7,14
PAYMENT_AUTO_CANCEL_AFTER_DAYS=30

# Cron
# Required in production. Send as x-cron-secret or Authorization: Bearer <secret>.
CRON_SECRET=replace-with-long-random-cron-secret

# Optional seed/admin script variables
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-locally

# System check options
# Set to 1 in CI when you only want structural validation and no external network probes.
SYSTEM_CHECK_SKIP_NETWORK=0
SYSTEM_CHECK_TIMEOUT_MS=6000
